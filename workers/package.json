{
  "name": "louzada-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create louzada-db",
    "db:apply:local": "wrangler d1 execute louzada-db --local --file=./schema/louzada_d1.sql",
    "db:apply:remote": "wrangler d1 execute louzada-db --remote --file=./schema/louzada_d1.sql",
    "db:migrate": "npm run db:apply:local",
    "db:migrate:remote": "npm run db:apply:remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.14.0"
  }
}
